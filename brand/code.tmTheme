<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Syntax colours for the PDF, the four accents and the ink theme.css gives a listing, and no more.
  Typst ships a stock theme whose red, blue and grey are off the Econ-ARK palette, and a show rule
  cannot reach the tokens, so the only way to recolour them is a theme file such as this one.

  The four foregrounds must equal --ark-code-keyword, --ark-code-comment, --ark-code-string and
  --ark-code-number in theme.css, where they are authored; check_code_palette holds the two ends
  together by reading those tokens and asserting the PDF prints them. Everything unscoped falls to
  the default foreground, so a call site and an attribute stay body ink, as they do on the site.
-->
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Econ-ARK</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key>
        <string>#00000000</string>
        <key>foreground</key>
        <string>#48464E</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Keyword</string>
      <key>scope</key>
      <string>keyword, storage, constant.language, entity.name.tag</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#1F476B</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Comment</string>
      <key>scope</key>
      <string>comment, punctuation.definition.comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#676470</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>String</string>
      <key>scope</key>
      <string>string, punctuation.definition.string</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#CE1160</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Name</string>
      <!-- Definitions and builtins, which is all highlight.js scopes: it marks a name at a `def`
           or `class` (.hljs-title) and a builtin (.hljs-built_in), and leaves a call site and an
           attribute unscoped. Typst's grammar does scope a call site, under variable.function, so
           naming that here would bold in the PDF what the site cannot bold at all. -->
      <key>scope</key>
      <string>entity.name.function, entity.name.class, support.function, support.type</string>
      <key>settings</key>
      <dict>
        <key>fontStyle</key>
        <string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Number</string>
      <key>scope</key>
      <string>constant.numeric</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#1F7A33</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
